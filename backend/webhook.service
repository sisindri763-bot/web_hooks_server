[Unit]
Description=Gunicorn instance to serve Webhook Server
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/web_hooks_server
Environment="PATH=/home/ubuntu/web_hooks_server/venv/bin"
ExecStart=/home/ubuntu/web_hooks_server/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:5000 wsgi:app

[Install]
WantedBy=multi-user.target
