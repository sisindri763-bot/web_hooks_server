# .env.example — Server environment variables template
# Copy this to .env on your deployment server (AWS EC2 / Render / Railway)

# ── Central Metadata Database (AWS RDS MySQL) ─────────────────────────────────
CENTRAL_DB_HOST=database-1.cho68wey201f.ap-south-2.rds.amazonaws.com
CENTRAL_DB_PORT=3306
CENTRAL_DB_NAME=webhooks_db
CENTRAL_DB_USER=admin
CENTRAL_DB_PASSWORD=your_rds_password

# ── Server & Security ────────────────────────────────────────────────────────
PORT=5000
LOG_LEVEL=INFO
ADMIN_TOKEN=your_admin_secret_token
WEBHOOK_SECRET=your_dbt_cloud_webhook_secret
