# .gitignore

# Virtual environments
.venv/
venv/
env/

# Python cache & artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Secrets
.env
backend/.env
frontend/.env

# Config DBs & local results
config/*.db
backend/config/*.db
results/*/
backend/results/*/

# Scratch files
test_chunk.js
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
